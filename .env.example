# Copy to .env and fill in. .env is gitignored.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PLANNER=deepseek-flash
DEEPSEEK_MODEL_SYNTHESIS=deepseek-flash
DEEPSEEK_MODEL_JUDGE=deepseek-flash
SCOUT_ALLOWED_MODELS=deepseek-flash

# mock = deterministic, no network, no spend. live = call DeepSeek.
SCOUT_LLM_MODE=mock
# Optional final synthesis pass; disabled by default after eval showed it hurt.
SCOUT_ENABLE_SYNTHESIS=false

# hash = offline deterministic; fastembed = real local embeddings (Phase 2+)
SCOUT_EMBEDDING_PROVIDER=hash
SCOUT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

SCOUT_DB_PATH=./data/scout.db
SCOUT_CORPUS_DIR=./corpus
SCOUT_INDEX_DIR=./corpus/index
SCOUT_STATIC_DIR=./frontend/dist
SCOUT_REPORTS_DIR=./reports

SCOUT_MAX_STEPS=25
SCOUT_TOKEN_BUDGET=60000
SCOUT_COST_BUDGET_USD=0.50
# Set provider prices to report $/task; 0 keeps cost at 0 while token counts still work.
SCOUT_COST_INPUT_PER_1K=0
SCOUT_COST_OUTPUT_PER_1K=0

# Scout API auth. Leave empty for loopback-only development.
SCOUT_REQUIRE_AUTH=false
SCOUT_API_KEY=

# Phase 3 safety
SCOUT_VERIFY_DNS=true
SCOUT_ALLOW_HTTP_LOCAL=false
SCOUT_SANDBOX_BACKEND=disabled   # disabled | subprocess | docker
SCOUT_SANDBOX_TIMEOUT_SECONDS=10
SCOUT_SANDBOX_IMAGE=python:3.10-slim

# Optional API keys for corpus acquisition (Phase 1).
S2_API_KEY=
GITHUB_TOKEN=

# Opt-in hybrid acquisition. Defaults keep the service offline (API only).
# Real MCP server over stdio; args must be a JSON array.
SCOUT_MCP_COMMAND=
SCOUT_MCP_ARGS=[]
SCOUT_MCP_TIMEOUT_SECONDS=30

# Fixed workflows: Crossref DOI, GitHub README, HF model card, official docs.
SCOUT_RPA_ENABLED=false

# Read-only Playwright fallback. Use msedge on Windows, or leave the channel
# empty after `playwright install chromium`.
SCOUT_GUI_ENABLED=false
SCOUT_GUI_ALLOWED_HOSTS=
SCOUT_GUI_BROWSER_CHANNEL=msedge

# Optional Engram long-term memory. Empty URL disables the adapter.
SCOUT_ENGRAM_URL=
SCOUT_ENGRAM_USER_ID=scout
SCOUT_ENGRAM_TENANT_ID=
SCOUT_ENGRAM_API_KEY=
SCOUT_ENGRAM_TOP_K=5
SCOUT_ENGRAM_TOKEN_BUDGET=800
SCOUT_ENGRAM_TIMEOUT_SECONDS=10
